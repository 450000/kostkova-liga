{
  "name": "dreamtale",
  "version": "0.1.0",
  "private": true,
  "description": "DREAMTALE – webová společenská hra o vyprávění a vybavování obrázků",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "images:build": "python3 scripts/build-cards.py",
    "build:single": "ARTIFACT_BUILD=1 next build && tsx scripts/build-single-file.ts"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "next": "^16.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}